# ---------------------------------------------------------------- Django
# The database is disposable — `python manage.py seed_problems` rebuilds the
# problem bank, so there is no reason to version a binary that churns constantly.
*.sqlite3
*.sqlite3-journal
db.sqlite3.bak-*

*.log
local_settings.py

# collectstatic output. Sources live in the project's static/ and ARE tracked.
/staticfiles/
/static_root/
/media/

# ---------------------------------------------------------------- Secrets
